              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loan-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "loan-requests"
              ]
            },
            "description": "Cliente A sin prestamos hoy pide 5.000.000 con score 720 e ingreso 4.000.000 (maximo 32.000.000). Debe aprobarse. Se guarda el id en {{loanId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Queda APPROVED con id, fecha de proceso y sin razon de rechazo\", () => {",
                  "    pm.expect(body.status).to.eql(\"APPROVED\");",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "    pm.expect(body.processedAt).to.be.a(\"string\");",
