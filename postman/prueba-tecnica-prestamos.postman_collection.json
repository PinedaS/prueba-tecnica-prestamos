{
  "info": {
    "name": "Prueba tecnica - Solicitudes de prestamo",
    "description": "Coleccion para recorrer RF01-RF06 en orden. Ejecutala completa con el Collection Runner (Run collection) o peticion por peticion de arriba hacia abajo.\n\nRequisito: la aplicacion corriendo en {{baseUrl}} (por defecto http://localhost:8080).\n\nLa primera peticion genera un \"runId\" unico, asi que puedes ejecutar la coleccion varias veces sin reiniciar la aplicacion: cada corrida usa referencias y clientes nuevos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Si se ejecuta una peticion suelta sin pasar por el Health check, genera un runId",
          "if (!pm.collectionVariables.get(\"runId\")) { pm.collectionVariables.set(\"runId\", Date.now().toString()); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Preparacion",
      "item": [
        {
          "name": "Health check (genera runId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Verifica que la app este arriba y genera un runId unico para esta corrida."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La aplicacion esta UP\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});",
                  "console.log(\"runId de esta corrida:\", pm.collectionVariables.get(\"runId\"));"
                ]
              }
            }
          ]
        }
      ]
    },
