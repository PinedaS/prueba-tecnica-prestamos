              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestReference\": \"REF-{{runId}}-001\",\n  \"customerId\": \"CLI-{{runId}}-A\",\n  \"requestedAmount\": 5000000,\n  \"termMonths\": 36,\n  \"monthlyIncome\": 4000000,\n  \"creditScore\": 720\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loan-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "loan-requests"
              ]
            },
            "description": "Reenvia exactamente la solicitud de RF01. No debe crear otra ni sumar cupo: si sumara, el cliente A tendria 20M. Fijate que el resultado sigue siendo APPROVED aunque hoy A ya no tenga cupo: se conserva el resultado del PRIMER procesamiento."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK (no 201): no se creo nada nuevo\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Header Idempotent-Replayed: true\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Mismo id y mismo resultado que la primera vez\", () => {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get(\"loanId\"));",
                  "    pm.expect(body.status).to.eql(\"APPROVED\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Misma referencia con otro monto -> 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
